# C18 cellular core only; preserve the full NixOS platform configuration.
CONFIG_WWAN=y
# CONFIG_MTK_MT6797_MD1 is not set
# CONFIG_MTK_MT6797_MD1_CLOCKED_OBSERVER is not set
CONFIG_FW_LOADER=y
CONFIG_MTK_MT6797_MD1_PRERELEASE=y
CONFIG_MTK_MT6797_MD1_FIRMWARE_PREFLIGHT=y
CONFIG_MTK_MT6797_MD1_MPU_REMAP_PLAN=y
CONFIG_MTK_MT6797_MD1_LK_HANDOFF=y
CONFIG_MTK_MT6797_MD1_LK_HANDOFF_PROBE=y
CONFIG_MTK_MT6797_MD1_BOOT_STATUS_OBSERVE=y
CONFIG_MTK_MT6797_MD1_COLD_OWNER=y
CONFIG_MTK_MT6797_MD1_FS_PROVIDER=y
CONFIG_MTK_MT6797_CCCI=y

CONFIG_TMPFS=y
