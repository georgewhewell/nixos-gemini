# Local diagnostic overlay applied after ixoo's frozen hardware profile.
#
# The entry ledger was useful while ixoo controlled the immediate next boot,
# but it intentionally prevents the normal ramoops backend from registering.
# On this device the intervening Gemian recovery boot can also initialise the
# ledger before it is read.  Use ordinary ramoops instead, and emit ixoo's
# attributable post-registration marker into its console zone.
# CONFIG_PSTORE_GEMINI_ARM64_ENTRY_LEDGER is not set
CONFIG_PSTORE_GEMINI_POST_RAMOOPS_CHECKPOINT=y

# The later ixoo experiment fragments removed the framebuffer console while
# retaining fbcon rotation/font settings.  Serial remains the primary console;
# tty0 is an independent, physically visible fallback.
CONFIG_CMDLINE="console=tty0 console=ttyS0,921600n8 earlycon maxcpus=8 nokaslr ignore_loglevel loglevel=8 log_buf_len=1M initcall_debug rdinit=/init panic=0 g_ether.dev_addr=42:00:15:19:82:01 g_ether.host_addr=42:00:15:19:82:00 g_ether.iManufacturer=gemini-pda-mainline g_ether.iProduct=Gemini-L-DA921x-Bind g_ether.iSerialNumber=GEMINI_DA921X_BIND_20260729 clk_ignore_unused fbcon=rotate:3 consoleblank=0 fbcon=font:TER16x32 regulator_ignore_unused initcall_blacklist=mt6797_a72_power_driver_init fw_devlink=rpm"
