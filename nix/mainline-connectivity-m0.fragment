# Hardware-free MT6797 connectivity foundations.  CONSYS and BTIF nodes remain
# disabled, so these codecs, lifecycle logic, and resource inventories cannot
# touch the device in the reviewed baseline image.
CONFIG_MTK_STP=y
# CONFIG_MTK_STP_KUNIT_TEST is not set
CONFIG_MTK_WMT=y
# CONFIG_MTK_WMT_KUNIT_TEST is not set
CONFIG_MTK_MT6797_CONSYS_INVENTORY=y
CONFIG_MTK_MT6797_CONSYS_CORE=y
# CONFIG_MTK_MT6797_CONSYS_CORE_KUNIT_TEST is not set
CONFIG_MTK_MT6797_CONSYS_STP_SESSION=y
# CONFIG_MTK_MT6797_CONSYS_STP_SESSION_KUNIT_TEST is not set
CONFIG_MTK_MT6797_BTIF_INVENTORY=y
CONFIG_MTK_MT6797_BTIF_PIO=y
# CONFIG_MTK_MT6797_BTIF_PIO_KUNIT_TEST is not set
CONFIG_MTK_MT6797_BTIF_PIO_PLATFORM=y
# CONFIG_MTK_MT6797_BTIF_PIO_PLATFORM_KUNIT_TEST is not set
CONFIG_MTK_MT6797_BTIF_STP_BOOTSTRAP=y
# CONFIG_MTK_MT6797_BTIF_STP_BOOTSTRAP_KUNIT_TEST is not set
CONFIG_GNSS=y
CONFIG_GNSS_MTK_CONSYS=y
# CONFIG_GNSS_MTK_CONSYS_KUNIT_TEST is not set
