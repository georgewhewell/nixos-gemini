diff --git a/driver/apdu/at_helpers.c b/driver/apdu/at_helpers.c
--- a/driver/apdu/at_helpers.c
+++ b/driver/apdu/at_helpers.c
@@ -1,4 +1,5 @@
 #include <stdarg.h>
+#include <errno.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -6,6 +7,7 @@
 #include "at_helpers.h"
 
 #include <lpac/utils.h>
+#include <euicc/hexutil.h>
 #include <unistd.h>
 
 inline void at_warning_message(void) {
@@ -34,12 +36,15 @@
         return -1;
 
     char **channels = userdata->channels;
+    char *replacement = identifier ? strdup(identifier) : NULL;
+    if (identifier && replacement == NULL)
+        return -1;
 
     if (channels[index]) {
         free(channels[index]);
     }
 
-    channels[index] = identifier ? strdup(identifier) : NULL;
+    channels[index] = replacement;
     return 0;
 }
 
@@ -64,7 +69,12 @@
     const int n = vsnprintf(NULL, 0, fmt, args_length);
     va_end(args_length);
 
-    _cleanup_free_ char *formatted = calloc(n + 2 /* CR+LF */ + 1, 1);
+    if (n < 0) {
+        va_end(args);
+        return -1;
+    }
+
+    _cleanup_free_ char *formatted = calloc((size_t)n + 2 /* CR+LF */ + 1, 1);
     if (formatted == NULL) {
         va_end(args);
         return -1;
@@ -82,3 +92,48 @@
     int ret = at_write_command(userdata, formatted);
     return ret;
 }
+
+int at_parse_apdu_response(const char *response, uint8_t **rx, uint32_t *rx_len) {
+    *rx = NULL;
+    *rx_len = 0;
+    if (response == NULL)
+        return -1;
+
+    response += strspn(response, " \t");
+    if (*response < '0' || *response > '9')
+        return -1;
+    char *end;
+    errno = 0;
+    unsigned long length = strtoul(response, &end, 10);
+    /* CGLA/CSIM lengths count hex characters; an R-APDU includes SW1/SW2. */
+    if (errno != 0 || length < 4 || length > UINT32_MAX || (length & 1))
+        return -1;
+    end += strspn(end, " \t");
+    if (*end != ',')
+        return -1;
+    const char *data = end + 1;
+    data += strspn(data, " \t");
+    size_t n = strlen(data);
+    while (n && (data[n - 1] == ' ' || data[n - 1] == '\t'))
+        n--;
+    if (n && data[0] == '"') {
+        if (n < 2 || data[n - 1] != '"')
+            return -1;
+        data++;
+        n -= 2;
+    }
+    if (n != length || strspn(data, "0123456789abcdefABCDEF") != n)
+        return -1;
+
+    uint8_t *decoded = malloc(n / 2);
+    if (decoded == NULL)
+        return -1;
+    int ret = euicc_hexutil_hex2bin_r(decoded, n / 2, data, n);
+    if (ret < 0) {
+        free(decoded);
+        return -1;
+    }
+    *rx = decoded;
+    *rx_len = ret;
+    return 0;
+}
