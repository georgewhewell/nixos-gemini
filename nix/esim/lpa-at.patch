+# SPDX-License-Identifier: GPL-3.0-only
+"""Read-only eUICC discovery and operation-scoped standard AT ownership."""
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+import json
+import os
+from pathlib import Path
+import re
+import select
+import selectors
+import stat
+import subprocess
+import time
+
+SERVICE = "org.freedesktop.ModemManager1"
+ROOT = "/org/freedesktop/ModemManager1"
+MODEM = SERVICE + ".Modem"
+SIM = SERVICE + ".Sim"
+OPERATION_TIMEOUT = 60.0
+MAX_OUTPUT = 1024 * 1024
+
+
+class AtError(Exception):
+    pass
+
+
+@dataclass(frozen=True)
+class AtTarget:
+    modem: str
+    uid: str = field(repr=False)
+    sim: str
+    slot: int
+    port: str
+    eid: str | None = field(repr=False)
+
+
+def discover(objects):
+    """Return typed primary AT candidates, not a claim that a card is an eUICC.
+
+    Generic AT ModemManager may have no SIM object or eUICC metadata for an
+    empty card. lpac must identify it under inhibition before UI admission.
+    Known conflicting SIM metadata must not be silently ignored.
+    """
+    targets = []
+    has_at = False
+    for path, interfaces in objects.items():
+        modem = interfaces.get(MODEM, {})
+        ports = modem.get("Ports", [])
+        if not any(kind == 3 for _, kind in ports):  # MM_MODEM_PORT_TYPE_AT
+            continue
+        has_at = True
+        port = modem.get("PrimaryPort")
+        if (port, 3) not in ports or not isinstance(port, str) or not re.fullmatch(r"[A-Za-z0-9_.-]+", port):
+            continue
+        sim_path = modem.get("Sim", "/")
+        if not isinstance(sim_path, str):
+            continue
+        sim = objects.get(sim_path, {}).get(SIM, {})
+        slot = modem.get("PrimarySimSlot", 0)
+        slots = modem.get("SimSlots", [])
+        if type(slot) is not int or slot < 0:
+            continue
+        if slots:
+            if not 1 <= slot <= len(slots) or slots[slot - 1] != sim_path:
+                continue
+        elif slot != 0:
+            continue
+        eid = sim.get("Eid", "")
+        uid = modem.get("Device")
+        if (sim and (sim.get("Active") is not True or sim.get("SimType", 0) not in (0, 2) or
+                     sim.get("EsimStatus", 0) not in (0, 1, 2))):
+            continue
+        if (not isinstance(eid, str) or (eid and not re.fullmatch(r"[0-9]{32}", eid)) or
+                not isinstance(uid, str) or not uid):
+            continue
+        targets.append(AtTarget(path, uid, sim_path, slot, "/dev/" + port, eid or None))
+    return targets, has_at
+
+
+class ModemManager:
+    """A private caller, retained until every lpac child has been reaped."""
+    def __init__(self):
+        from gi.repository import Gio, GLib
+        self.Gio, self.GLib = Gio, GLib
+        address = Gio.dbus_address_get_for_bus_sync(Gio.BusType.SYSTEM, None)
+        self.connection = Gio.DBusConnection.new_for_address_sync(
+            address, Gio.DBusConnectionFlags.AUTHENTICATION_CLIENT |
+            Gio.DBusConnectionFlags.MESSAGE_BUS_CONNECTION, None, None)
+        self.connection.set_exit_on_close(False)
+        try:
+            self.owner = self._owner()
+        except BaseException:
+            self.close()
+            raise
+
+    def _call(self, destination, path, interface, method, signature=None, arguments=(), interactive=False):
+        try:
+            flags = self.Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION if interactive else self.Gio.DBusCallFlags.NONE
+            params = self.GLib.Variant(signature, arguments) if signature else None
+            return self.connection.call_sync(destination, path, interface, method, params,
+                                             None, flags, 30000 if interactive else 5000, None).unpack()
+        except self.GLib.Error as error:
+            raise AtError("ModemManager is unavailable or denied AT ownership.") from error
+
+    def _owner(self):
+        return self._call("org.freedesktop.DBus", "/org/freedesktop/DBus",
+                          "org.freedesktop.DBus", "GetNameOwner", "(s)", (SERVICE,))[0]
+
+    def targets(self):
+        objects = self._call(self.owner, ROOT, "org.freedesktop.DBus.ObjectManager", "GetManagedObjects")[0]
+        return discover(objects)
+
+    def alive(self):
+        return not self.connection.is_closed() and self._owner() == self.owner
+
+    def inhibit(self, uid, value):
+        self._call(self.owner, ROOT, SERVICE, "InhibitDevice", "(sb)", (uid, value), interactive=value)
+
+    def close(self):
+        try:
+            if not self.connection.is_closed():
+                self.connection.close_sync(None)
+        except self.GLib.Error as error:
+            raise AtError("ModemManager AT ownership caller could not be closed.") from error
+
+
+def at_environment(fd):
+    """Own the selected transport; never silently accept another device/slot."""
+    env = os.environ.copy()
+    for key in env:
+        if key in ("AT_DEVICE", "AT_DEBUG", "UIM_SLOT", "MBIM_DEVICE", "MBIM_USE_PROXY") or key.startswith("LPAC_APDU_"):
+            raise AtError("Inherited AT transport or slot overrides conflict with ModemManager ownership.")
+    if env.get("LPAC_APDU", "at") != "at":
+        raise AtError("Inherited lpac backend conflicts with the selected AT modem.")
+    env.update(LPAC_APDU="at", LPAC_APDU_AT_DEVICE=f"/proc/self/fd/{fd}", LPAC_APDU_AT_DEBUG="0")
+    return env
+
+
+def check_endpoint_owner(fd):
+    """Admit the standard WWAN owner whose open lifetime pins its minor.
+
+    TTY support additionally needs an acquisition sequence compatible with
+    ModemManager's TIOCEXCL ownership; opening before inhibition is insufficient
+    for a generic tty. Do not bypass that exclusion.
+    """
+    info = os.fstat(fd)
+    if not stat.S_ISCHR(info.st_mode):
+        raise AtError("Selected AT endpoint is not a character device.")
+    node = Path(f"/sys/dev/char/{os.major(info.st_rdev)}:{os.minor(info.st_rdev)}")
+    try:
+        subsystem = (node / "subsystem").resolve(strict=True).name
+        if subsystem == "wwan":
+            with (node / "type").open() as port_type:
+                if port_type.read(32) == "AT\n":
+                    return
+    except OSError:
+        pass
+    raise AtError("AT discovery currently requires a standard WWAN port; TTY ownership remains unfinished.")
+
+
+class AtOperation:
+    def __init__(self, manager, target, executable, cancelled, fd):
+        self.manager, self.target, self.executable = manager, target, executable
+        self.cancelled, self.fd = cancelled, fd
+        self.fingerprint = os.fstat(fd)
+        self.deadline = time.monotonic() + OPERATION_TIMEOUT
+        self.env = at_environment(fd)
+        self.poller = select.poll()
+        self.poller.register(fd, select.POLLERR | select.POLLHUP | select.POLLNVAL)
+
+    def check(self):
+        if self.cancelled.is_set():
+            raise AtError("AT operation cancelled.")
+        if time.monotonic() >= self.deadline:
+            raise AtError("AT operation timed out; modem long-response support is unqualified.")
+        current = os.stat(self.target.port)
+        if ((current.st_dev, current.st_ino, current.st_rdev) !=
+                (self.fingerprint.st_dev, self.fingerprint.st_ino, self.fingerprint.st_rdev) or
+                self.poller.poll(0) or not self.manager.alive()):
+            raise AtError("Selected AT endpoint or ModemManager disappeared or changed.")
+
+    def lines(self, arguments):
+        """Bound silent children; generator close/error also reaps before release."""
+        self.check()
+        process = subprocess.Popen([self.executable, *arguments], env=self.env,
+                                   pass_fds=(self.fd,), stdout=subprocess.PIPE, stderr=subprocess.PIPE)
+        pending = b""
+        total = 0
+        try:
+            with selectors.DefaultSelector() as selector:
+                for pipe in (process.stdout, process.stderr):
+                    os.set_blocking(pipe.fileno(), False)
+                    selector.register(pipe, selectors.EVENT_READ)
+                while selector.get_map():
+                    self.check()
+                    for key, _ in selector.select(0.1):
+                        data = os.read(key.fileobj.fileno(), 4096)
+                        if not data:
+                            selector.unregister(key.fileobj)
+                            continue
+                        total += len(data)
+                        if total > MAX_OUTPUT:
+                            raise AtError("lpac AT output exceeded its operation bound.")
+                        if key.fileobj is process.stdout:
+                            pending += data
+                            while b"\n" in pending:
+                                line, pending = pending.split(b"\n", 1)
+                                yield line.decode("utf-8")
+                while process.poll() is None:
+                    self.check()
+                    time.sleep(0.1)
+                if process.wait() != 0:
+                    raise AtError("lpac AT request failed; no profile changes were attempted.")
+                if pending:
+                    yield pending.decode("utf-8")
+                self.check()
+        finally:
+            if process.poll() is None:
+                process.terminate()
+                try:
+                    process.wait(timeout=2)
+                except subprocess.TimeoutExpired:
+                    process.kill()
+                    process.wait()
+            else:
+                process.wait()
+            process.stdout.close()
+            process.stderr.close()
+
+    def read(self, arguments):
+        try:
+            output = json.loads("\n".join(self.lines(arguments)))
+            payload = output["payload"]
+            if output["type"] != "lpa" or payload["code"] != 0:
+                raise ValueError("failed lpac response")
+            return payload["data"]
+        except (ValueError, KeyError, TypeError) as error:
+            raise AtError("lpac did not return a successful, complete AT response.") from error
+
+
+@contextmanager
+def operation(target, executable, cancelled, expected_eid=None):
+    if cancelled.is_set():
+        raise AtError("AT operation cancelled.")
+    manager = ModemManager()
+    inhibited = False
+    fd = None
+    try:
+        targets, _ = manager.targets()
+        if target not in targets:
+            raise AtError("Selected modem, SIM metadata or AT identity changed; rediscovery is required.")
+        # Pin the endpoint before intentional MM unexport. Opening sends no AT
+        # command; exclusive command access begins only after inhibition.
+        fd = os.open(target.port, os.O_RDWR | os.O_NOCTTY | os.O_CLOEXEC | os.O_NONBLOCK)
+        check_endpoint_owner(fd)
+        manager.inhibit(target.uid, True)
+        inhibited = True
+        owned = AtOperation(manager, target, executable, cancelled, fd)
+        info = owned.read(["chip", "info"])
+        eid = info.get("eidValue") if isinstance(info, dict) else None
+        if (not isinstance(eid, str) or not re.fullmatch(r"[0-9]{32}", eid) or
+                (target.eid is not None and eid != target.eid) or
+                (expected_eid is not None and eid != expected_eid)):
