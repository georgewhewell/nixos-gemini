+class DBusCaller(unittest.TestCase):
+    def test_actual_adapter_uses_one_unique_caller_and_cached_owner(self):
+        events = []
+
+        class Error(Exception):
+            pass
+
+        class Variant:
+            def __init__(self, signature, arguments):
+                self.signature, self.arguments = signature, arguments
+
+            def unpack(self):
+                return self.arguments
+
+        class Connection:
+            closed = False
+            owner = ":fixture.mm"
+            denied = False
+            fail_close = False
+
+            def set_exit_on_close(self, value):
+                self.assert_exit = value
+
+            def is_closed(self):
+                return self.closed
+
+            def close_sync(self, cancellable):
+                events.append("close")
+                if self.fail_close:
+                    raise Error("fixture close failure")
+                self.closed = True
+
+            def call_sync(self, destination, path, interface, method, params, reply_type, flags, timeout, cancellable):
+                events.append((destination, path, interface, method, params, flags, timeout))
+                if self.denied:
+                    raise Error("fixture denied")
+                if method == "GetNameOwner":
+                    return Variant(None, (self.owner,))
+                if method == "GetManagedObjects":
+                    return Variant(None, (objects(),))
+                return Variant(None, ())
+
+        connection = Connection()
+        Gio = types.SimpleNamespace(
+            BusType=types.SimpleNamespace(SYSTEM=1),
+            DBusConnectionFlags=types.SimpleNamespace(AUTHENTICATION_CLIENT=1, MESSAGE_BUS_CONNECTION=2),
+            DBusCallFlags=types.SimpleNamespace(NONE=0, ALLOW_INTERACTIVE_AUTHORIZATION=1),
+            dbus_address_get_for_bus_sync=lambda *_: "fixture:bus",
+            DBusConnection=types.SimpleNamespace(new_for_address_sync=lambda *_: connection))
+        GLib = types.SimpleNamespace(Variant=Variant, Error=Error)
+        gi = types.ModuleType("gi")
+        repository = types.ModuleType("gi.repository")
+        repository.Gio, repository.GLib = Gio, GLib
+        gi.repository = repository
+        with patch.dict(sys.modules, {"gi": gi, "gi.repository": repository}):
+            manager = mm.ModemManager()
+            self.assertFalse(connection.assert_exit)
+            self.assertEqual(manager.targets(), mm.discover(objects()))
+            manager.inhibit("fixture-modem", True)
+            manager.inhibit("fixture-modem", False)
+            calls = [e for e in events if isinstance(e, tuple) and e[3] == "InhibitDevice"]
+            self.assertEqual([c[0] for c in calls], [":fixture.mm", ":fixture.mm"])
+            self.assertEqual([c[4].signature for c in calls], ["(sb)", "(sb)"])
+            self.assertEqual([c[4].arguments for c in calls], [("fixture-modem", True), ("fixture-modem", False)])
+            self.assertEqual([c[5:] for c in calls], [(1, 30000), (0, 5000)])
+            connection.owner = ":fixture.replacement"
+            self.assertFalse(manager.alive())
+            connection.denied = True
+            with self.assertRaises(mm.AtError):
+                manager.inhibit("fixture-modem", False)
+            manager.close()
+            self.assertTrue(connection.closed)
+            connection = Connection()
+            connection.denied = True
+            with self.assertRaises(mm.AtError):
+                mm.ModemManager()
+            self.assertTrue(connection.closed)
+            connection = Connection()
+            manager = mm.ModemManager()
+            connection.fail_close = True
+            with self.assertRaisesRegex(mm.AtError, "caller could not be closed") as raised:
+                manager.close()
+            self.assertIsInstance(raised.exception.__cause__, Error)
+            connection.denied = True
+            with self.assertRaisesRegex(mm.AtError, "caller could not be closed") as raised:
+                mm.ModemManager()
+            original = raised.exception.__cause__.__context__
+            self.assertIsInstance(original, mm.AtError)
+            self.assertIn("denied", str(original))
