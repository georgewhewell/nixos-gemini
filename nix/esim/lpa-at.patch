+    def test_fd_close_failure_still_uninhibits_and_closes_caller(self):
+        close = os.close
+        pin = mm.check_endpoint_owner
+        endpoint = []
+        def record_pin(fd):
+            pin(fd)
+            endpoint[:] = [fd]
+        def failed_close(fd):
+            close(fd)  # Linux may already release the descriptor on an error.
+            if endpoint and fd == endpoint[0]:
+                endpoint.clear()
+                raise OSError("fixture close failure")
+        with patch.object(mm, "check_endpoint_owner", side_effect=record_pin), patch.object(mm.os, "close", side_effect=failed_close):
+            with self.assertRaisesRegex(mm.AtError, "endpoint could not be closed"):
+                self.operate()
+        self.assert_clean()
+        self.state.fail_release = True
+        with patch.object(mm, "check_endpoint_owner", side_effect=record_pin), patch.object(mm.os, "close", side_effect=failed_close):
+            with self.assertRaisesRegex(mm.AtError, "release failed") as raised:
+                self.operate()
+        self.assertIn("endpoint could not be closed", str(raised.exception.__context__))
+        self.assertEqual(self.state.events[-1], "caller-close")
