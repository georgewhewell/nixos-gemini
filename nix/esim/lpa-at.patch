+class ModemManagerAtBackend(LpacBackend):
+    """Read-only AT support after lpac identifies the selected endpoint's eUICC."""
+
+    # TODO: qualify CCHO/CGLA completion for profile-size APDUs and modem
+    # long operations, and define post-abort late-response/channel recovery.
+    # The current integration is read-only; AT modems are not inherently
+    # incapable of profile changes, and MM has no property proving this.
+    supports_profile_changes = False
+    needs_background_io = True
+
+    def __init__(self, target: modemmanager.AtTarget, cancelled=None):
+        # A single-SIM MM modem reports slot 0; 1 is only the existing UI key.
+        super().__init__(target.slot or 1, ESimBackend.Type.AT)
+        self.target = target
+        self.cancelled = cancelled if cancelled is not None else threading.Event()
+        self.operation_lock = threading.Lock()
+        self.verified_eid = None
+        self.failed = False
+
+    def cancel(self):
+        self.cancelled.set()
+
+    def is_operational(self):
+        try:
+            self.get_chip_info()
+            return True
+        except ESimError as error:
+            self.unavailable_reason = str(error)
+            return False
+
+    def _run_lpac(self, arguments):
+        if tuple(arguments) not in (("chip", "info"), ("profile", "list"), ("notification", "list")):
+            raise ESimError("AT profile changes require qualified modem long-response support.")
+        with self.operation_lock:
+            if self.failed:
+                raise ESimError("AT session failed; rediscovery is required.")
+            try:
+                with modemmanager.operation(self.target, self.lpac_exe, self.cancelled, self.verified_eid) as (owned, info):
+                    self.verified_eid = info["eidValue"]
+                    association = ("eUICC matches ModemManager's active SIM." if self.target.eid else
+                                   "eUICC verified on the selected AT endpoint; physical SIM slot is unknown.")
+                    self.read_only_reason = association + " Profile changes remain unfinished."
+                    return info if arguments == ["chip", "info"] else owned.read(arguments)
+            except modemmanager.AtError as error:
+                # Latch while still holding the operation lock, so queued GUI
+                # reads cannot retry an uncertain AT stream.
+                self.failed = True
+                raise ESimError(str(error)) from error
+
+    def _run_lpac_stream(self, arguments):
+        raise ESimError("AT profile changes require qualified modem long-response support.")
 
 
