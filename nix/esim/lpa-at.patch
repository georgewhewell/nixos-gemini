+    def test_queued_backend_reads_do_not_retry_after_uncertain_session(self):
+        with patch.object(esim.shutil, "which", return_value=str(self.child)):
+            backend = esim.ModemManagerAtBackend(self.target)
+            self.assertTrue(backend.is_operational())
+            failures = []
+            def read():
+                try:
+                    backend.get_profiles()
+                except esim.ESimError as error:
+                    failures.append(str(error))
+            before = len(self.state.children)
+            with patch.dict(os.environ, FIXTURE_MODE="wrong-eid"):
+                threads = [threading.Thread(target=read), threading.Thread(target=read)]
+                for thread in threads:
+                    thread.start()
+                for thread in threads:
+                    thread.join(5)
+                    self.assertFalse(thread.is_alive())
+            self.assertEqual(len(failures), 2)
+            self.assertEqual(len(self.state.children), before + 1)
+            self.assertTrue(backend.failed)
+            self.assert_clean()
