+class TrackedChild:
+    def __init__(self, *args, **kwargs):
+        self.process = Popen(*args, **kwargs)
+        self.reaped = False
+
+    def __getattr__(self, name):
+        return getattr(self.process, name)
+
+    def wait(self, *args, **kwargs):
+        result = self.process.wait(*args, **kwargs)
+        self.reaped = True
+        return result
+
+
+class State:
+    def __init__(self):
+        self.events, self.children = [], []
+        self.alive, self.denied, self.fail_release = True, False, False
+        self.inhibited, self.changed = False, False
+        self.target = None
+
+    def reaped(self):
+        return all(child.reaped for child in self.children)
+
+
+class Runner(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.directory = Path(self.temp.name)
+        self.master, self.slave = os.openpty()
+        self.port = self.directory / "selected-at"
+        self.port.symlink_to(os.ttyname(self.slave))
+        self.target = mm.AtTarget("/modem/0", "fixture-modem", "/sim/1", 2, str(self.port), EID)
+        self.cancelled = threading.Event()
+        self.state = State()
+        self.state.target = self.target
+        self.child = self.directory / "lpac-fixture"
+        self.child.write_text("#!" + sys.executable + r'''
+import json, os, signal, sys, time
+fd = os.open(os.environ["LPAC_APDU_AT_DEVICE"], os.O_RDWR | os.O_NOCTTY)
+assert os.fstat(fd).st_rdev == os.fstat(int(os.environ["LPAC_APDU_AT_DEVICE"].split("/")[-1])).st_rdev
+mode = os.environ.get("FIXTURE_MODE", "success")
+if mode == "ignore-term": signal.signal(signal.SIGTERM, signal.SIG_IGN)
+if mode in ("silent", "ignore-term"):
+    print('{"type":"progress"}', flush=True)
+    while True: time.sleep(.05)
+if mode == "failure": sys.exit(1)
+if mode == "malformed": print("not-json"); sys.exit(0)
+if mode == "oversized": print("x" * 16384); sys.exit(0)
+value = {"eidValue": ("1" if mode == "wrong-eid" else "0") * 32} if sys.argv[1:] == ["chip", "info"] else []
+print(json.dumps({"type":"lpa", "payload":{"code":0, "data":value}}))
+''')
+        self.child.chmod(0o700)
+        state = self.state
+
+        class Manager:
+            def __init__(self):
+                state.events.append("caller-open")
+
+            def targets(self):
+                if state.inhibited:
+                    raise AssertionError("intentional unexport must use cached identity")
+                return ([] if state.changed else [state.target], True)
+
+            def alive(self):
+                return state.alive
+
+            def inhibit(self, uid, value):
+                assert uid == "fixture-modem"
+                if value:
+                    if state.denied:
+                        raise mm.AtError("denied")
+                    state.inhibited = True
+                    state.events.append("inhibit")
+                else:
+                    assert state.reaped(), "child was not reaped before uninhibition"
+                    state.events.append("uninhibit")
+                    if state.fail_release:
+                        raise mm.AtError("release failed")
+                    state.inhibited = False
+
+            def close(self):
+                assert state.reaped(), "caller died before child reaping"
+                state.events.append("caller-close")
+                state.inhibited = False
+
+        def spawn(*args, **kwargs):
+            assert state.inhibited
+            assert kwargs["env"]["LPAC_APDU"] == "at"
+            assert "LPAC_APDU_QMI_UIM_SLOT" not in kwargs["env"]
+            fd = kwargs["pass_fds"][0]
+            assert kwargs["env"]["LPAC_APDU_AT_DEVICE"] == f"/proc/self/fd/{fd}"
+            child = TrackedChild(*args, **kwargs)
+            state.children.append(child)
+            return child
+
+        def pin(fd):
+            assert not state.inhibited, "endpoint must be pinned before intentional MM unexport"
+            assert os.fstat(fd).st_rdev == os.stat(self.port).st_rdev
+            state.events.append("pin")
+
+        clean = {k: v for k, v in os.environ.items()
+                 if not k.startswith("LPAC_APDU") and k not in ("AT_DEVICE", "AT_DEBUG", "UIM_SLOT", "MBIM_DEVICE", "MBIM_USE_PROXY")}
+        self.patches = [patch.object(mm, "ModemManager", Manager), patch.object(mm.subprocess, "Popen", spawn),
+                        patch.object(mm, "check_endpoint_owner", pin),
+                        patch.dict(os.environ, clean, clear=True)]
+        for p in self.patches:
+            p.start()
+
+    def tearDown(self):
+        for child in self.state.children:
+            if child.poll() is None:
+                child.kill()
+                child.wait()
+        for p in reversed(self.patches):
+            p.stop()
+        if self.master >= 0:
+            os.close(self.master)
+        os.close(self.slave)
+        self.temp.cleanup()
+
+    def operate(self):
+        with mm.operation(self.target, str(self.child), self.cancelled) as (owned, info):
+            self.assertEqual(info["eidValue"], EID)
+            return owned.read(["profile", "list"])
+
+    def assert_clean(self):
+        self.assertTrue(self.state.reaped())
+        self.assertFalse(self.state.inhibited)
+        self.assertEqual(self.state.events[-2:], ["uninhibit", "caller-close"])
+
+    def test_success_intentional_unexport_and_same_endpoint(self):
+        self.assertEqual(self.operate(), [])
+        self.assertEqual(len(self.state.children), 2)
+        self.assertEqual(self.state.events, ["caller-open", "pin", "inhibit", "uninhibit", "caller-close"])
+        self.assert_clean()
+
+    def test_identity_change_and_denial_never_spawn(self):
+        for key in ("changed", "denied"):
+            with self.subTest(key=key):
+                setattr(self.state, key, True)
