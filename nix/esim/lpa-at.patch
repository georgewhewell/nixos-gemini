+class UIWorkers(unittest.TestCase):
+    @staticmethod
+    def production_class(path, name, methods, namespace, base=object):
+        source = ast.parse((ROOT / path).read_text())
+        owner = next(node for node in source.body if isinstance(node, ast.ClassDef) and node.name == name)
+        definition = ast.ClassDef(name=name, bases=[ast.Name(id="Base", ctx=ast.Load())], keywords=[],
+                                  body=[node for node in owner.body if isinstance(node, ast.FunctionDef) and node.name in methods],
+                                  decorator_list=[])
+        namespace["Base"] = base
+        exec(compile(ast.fix_missing_locations(ast.Module(body=[definition], type_ignores=[])), path, "exec"), namespace)
+        return namespace[name]
