# The opt-in thermal/Hall observer only enables existing MT6797 AUXADC,
# thermal, and GPIO-key paths.  Building all three drivers in avoids a module
# loader dependency in the minimal Stage 1/2 images; it adds no writable
# regulator, wakeup, SCP, or external-sensor contract.
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_MTK_THERMAL=y
CONFIG_MTK_SOC_THERMAL=y
CONFIG_IIO=y
CONFIG_MEDIATEK_MT6577_AUXADC=y
CONFIG_KEYBOARD_GPIO=y
