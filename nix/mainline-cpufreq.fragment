# M41: Cortex-A53 frequency scaling through the generic OPP driver.
# cpufreq-dt is a module; Stage 2 loads it at boot after the A72s are up
# and selects schedutil (nixos/core-parking.nix).
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=m
CONFIG_CPUFREQ_DT_PLATDEV=y
# CONFIG_ARM_MEDIATEK_CPUFREQ is not set
# CONFIG_ARM_MEDIATEK_CPUFREQ_HW is not set
CONFIG_CPU_THERMAL=y
# MT6797 BL31 has no per-core power-down program behind PSCI CPU_SUSPEND
# (see mainline-spm.fragment); keep cpuidle off.
# CONFIG_CPU_IDLE is not set
