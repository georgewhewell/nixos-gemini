# M41: Cortex-A53 frequency scaling through the generic OPP driver.
# cpufreq-dt is a module and blacklisted from autoloading on the kernel
# command line, so the first transitions happen only when loaded by hand.
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPUFREQ_DT=m
CONFIG_CPUFREQ_DT_PLATDEV=y
# CONFIG_ARM_MEDIATEK_CPUFREQ is not set
# CONFIG_ARM_MEDIATEK_CPUFREQ_HW is not set
CONFIG_CPU_THERMAL=y
# PSCI power-down idle states rely on SPM MCDI firmware that Linux does not load.
# CONFIG_CPU_IDLE is not set
