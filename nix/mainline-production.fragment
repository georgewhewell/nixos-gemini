# Normal Gemini PDA mainline kernel.  Start from ixoo's small, hardware-proven
# LK handoff configuration, then enable only services present in the production
# board DT.  Drivers are built in because Stage 1 has no module loader.
CONFIG_LOCALVERSION="-gemini-production"
# CONFIG_LOCALVERSION_AUTO is not set
# CONFIG_MODULES is not set

CONFIG_CMDLINE="console=tty0 console=ttyS0,921600n8 earlycon maxcpus=8 loglevel=7 log_buf_len=1M rdinit=/init panic=5 g_ether.dev_addr=42:00:15:19:82:01 g_ether.host_addr=42:00:15:19:82:00 g_ether.iManufacturer=gemini-pda-mainline g_ether.iProduct=Gemini-Mainline g_ether.iSerialNumber=GEMINI_MAINLINE clk_ignore_unused regulator_ignore_unused fbcon=rotate:3 consoleblank=0 fbcon=font:TER16x32 fw_devlink=rpm"
CONFIG_CMDLINE_FORCE=y

# Persistent recovery evidence and an ordinary visible console.
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# CONFIG_PSTORE_COMPRESS is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
CONFIG_FONT_TER16x32=y

# The Stage-1/Stage-2 root and eMMC-resident Nix store.
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MFD_MT6397=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6351=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# Left USB-C: fixed peripheral role and the recovery Ethernet gadget.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_NETDEVICES=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_MTU3=y
CONFIG_USB_MTU3_GADGET=y
# CONFIG_USB_MTU3_HOST is not set
# CONFIG_USB_MTU3_DUAL_ROLE is not set
CONFIG_GENERIC_PHY=y
CONFIG_PHY_MTK_TPHY=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
# CONFIG_USB_CONFIGFS is not set
# CONFIG_USB_MASS_STORAGE is not set

# Right USB-C: fixed host role, FUSB301 attach detection, and RTL815x Ethernet.
CONFIG_PACKET=y
CONFIG_USB=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_HOST=y
# CONFIG_USB_MUSB_GADGET is not set
# CONFIG_USB_MUSB_DUAL_ROLE is not set
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_MUSB_PIO_ONLY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_TYPEC=y
CONFIG_TYPEC_FUSB301=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# Preserve LK's BQ25896 charge policy while servicing its watchdog, and expose
# the calibrated MT6351 current/coulomb counter through power_supply.
CONFIG_POWER_SUPPLY=y
CONFIG_CHARGER_BQ25890=y
CONFIG_BATTERY_MT6351_FGADC=y
# CONFIG_MT6351_FG_READONLY is not set
# CONFIG_BQ25890_CHARGER_KUNIT_TEST is not set

# Native display, enabled directly by mt6797-gemini-pda.dts.
CONFIG_DRM=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANEL_NOVATEK_NT36672E=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_MTK_MMSYS=y
CONFIG_MTK_SMI=y
# CONFIG_MTK_IOMMU is not set
CONFIG_COMMON_CLK_MT6797_MMSYS=y
CONFIG_MTK_SCPSYS=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_REGULATOR_LP3101=y

# Physical keyboard: AW9523 GPIO/pinctrl provider plus generic matrix input.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MATRIX=y
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_PINCTRL_AW9523=y

# Build the complete camera media path into the monolithic image.  Its DT
# route remains disabled until the coordinated sensor/receiver/capture test.
CONFIG_NVMEM=y
CONFIG_NVMEM_MTK_ATAG_DEVINFO=y
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEO_HI556=y
CONFIG_VIDEO_MTK_MT6797_SENINF=y
CONFIG_VIDEO_MTK_MT6797_CAMSV=y
CONFIG_COMMON_CLK_MT6797_CAMSYS=y

# Integrated MT6797 connectivity.  Keep the complete CONSYS, BTIF/STP/WMT,
# firmware, and WLAN ownership chain built in: firmware is available in Stage
# 1 and the standard cfg80211/nl80211 interface is consumed by wpa_supplicant.
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_RFKILL=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_MTK_STP=y
CONFIG_MTK_MT6797_CONSYS_STP_SESSION=y
CONFIG_MTK_MT6797_BTIF_PIO=y
CONFIG_MTK_MT6797_BTIF_PIO_PLATFORM=y
CONFIG_MTK_MT6797_BTIF_STP_BOOTSTRAP=y
CONFIG_MTK_WMT=y
CONFIG_MTK_MT6797_CONSYS_WMT_INITIAL=y
CONFIG_MTK_MT6797_CONSYS_CORE=y
CONFIG_MTK_MT6797_CONSYS_POSTID=y
CONFIG_MTK_MT6797_CONSYS_EMI_LAYOUT=y
CONFIG_MTK_MT6797_CONSYS_EMI_MPU=y
CONFIG_MTK_MT6797_CONSYS_RUNTIME=y
CONFIG_MTK_MT6797_CONSYS_RUNTIME_CONTROLLER=y
CONFIG_MTK_MT6797_CONSYS_FIRMWARE_METADATA=y
CONFIG_MTK_MT6797_CONSYS_WMT_PATCH_DOWNLOAD=y
CONFIG_MTK_MT6797_CONSYS_WMT_POSTPATCH=y
CONFIG_MT6797_WIFI=y

# Panfrost first light uses the LK-proven 500.5 MHz clock at a single fixed
# 975 mV OPP.  DVFS remains deliberately absent until this point renders and
# survives runtime power transitions on the real board.
CONFIG_REGULATOR_RT5735=y
CONFIG_COMMON_CLK_MT6797_MFGSYS=y
CONFIG_DRM_PANFROST=y

# Retain the bootloader watchdog until Stage 1 opens it.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WATCHDOG_OPEN_TIMEOUT=90
CONFIG_WATCHDOG_SYSFS=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=5
