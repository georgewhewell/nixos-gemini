/dts-v1/;
/plugin/;

/*
 * Fixed-host enablement for the physical right USB-C port.  The MT6797
 * controller/PHY resources and host policy are already carried in the ixoo
 * base DT.  The physical connector also needs the board's FUSB301A CC
 * controller, GPIO94 VBUS load switch, and GPIO70/71/72 USB route state.
 */
&{/} {
	usb11_vbus: regulator-usb11-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb11-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		/* The fixed, hash-validated base DT assigns phandle 9 to MT6797 PIO. */
		gpio = <0x9 94 0>;
		enable-active-high;
	};
};

&{/pinctrl@10005000} {
	usb11_i2c0_pins: usb11-i2c0-pins {
		pins-bus {
			/* GPIO37=SCL0_0, GPIO38=SDA0_0. */
			pinmux = <0x2501 0x2601>;
		};
	};

	/* FUSB301A ID is wired from GPIO64's EINT3 function. */
	usb11_fusb301a_irq_pins: usb11-fusb301a-irq-pins {
		pins-irq {
			pinmux = <0x4001>;
		};
	};

	/* Vendor fixed USB route: SW_EN=1, SW_SEL=0, SW7226_EN=1. */
	usb11-sw-en-hog {
		gpio-hog;
		gpios = <70 0>;
		output-high;
		line-name = "usb11-fusb301a-sw-en";
	};

	usb11-sw-sel-hog {
		gpio-hog;
		gpios = <71 0>;
		output-low;
		line-name = "usb11-fusb301a-sw-sel";
	};

	usb11-route-enable-hog {
		gpio-hog;
		gpios = <72 0>;
		output-high;
		line-name = "usb11-sw7226-enable";
	};
};

&{/i2c@11007000} {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&usb11_i2c0_pins>;
	status = "okay";

	typec@25 {
		compatible = "onsemi,fusb301a";
		reg = <0x25>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb11_fusb301a_irq_pins>;
		interrupt-parent = <0x9>;
		interrupts = <3 3>;
		vbus-supply = <&usb11_vbus>;

		connector {
			compatible = "usb-c-connector";
			label = "Gemini right USB-C";
			power-role = "source";
			data-role = "host";
			typec-power-opmode = "default";
			pd-disable;
		};
	};
};

&{/t-phy@11210000} {
	/*
	 * The T-PHY driver owns this common window, while the child below owns
	 * 0x11210800..0x112108ff. Keeping the inherited 0x1000 size makes those
	 * resources overlap and the child fails to map with -EBUSY. Match the
	 * already-working MT6797 T-PHY layout at 0x11290000: common registers are
	 * the first 0x800 bytes and the port begins at offset 0x800.
	 */
	reg = <0 0x11210000 0 0x800>;
	status = "okay";
};

&{/t-phy@11210000/usb-phy@11210800} {
	/* Match the vendor USB11 host PHY's forced A-session register state. */
	mediatek,force-a-session-valid;
	status = "okay";
};

&{/usb@11200000} {
	status = "okay";
	dr_mode = "host";
};
