# One-shot G2c patch-only radio chronology.  It is deliberately a successor
# to a separately accepted G2b HCR/HVR/FVR/full-STP cycle: the DT overlay and
# seven independent read-only boot parameters still gate all live activity.
# This fragment builds the exact hash-pinned manifest owner; it creates no
# Wi-Fi, Bluetooth, GNSS, FM, HCI, or network function.
CONFIG_MFD_SYSCON=y
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_MT6351=y
CONFIG_MTK_SCPSYS=y
CONFIG_FW_LOADER=y
CONFIG_MTK_MT6797_CONSYS_POSTID=y
# CONFIG_MTK_MT6797_CONSYS_POSTID_KUNIT_TEST is not set
CONFIG_MTK_MT6797_CONSYS_EMI_MPU=y
CONFIG_MTK_MT6797_CONSYS_RUNTIME=y
# CONFIG_MTK_MT6797_CONSYS_RUNTIME_KUNIT_TEST is not set
CONFIG_MTK_MT6797_CONSYS_FIRMWARE_PREFLIGHT=y
CONFIG_MTK_MT6797_CONSYS_WMT_PATCH_DOWNLOAD=y
# CONFIG_MTK_MT6797_CONSYS_WMT_PATCH_DOWNLOAD_KUNIT_TEST is not set
CONFIG_MTK_MT6797_CONSYS_RUNTIME_CONTROLLER=y
# CONFIG_MTK_MT6797_CONSYS_RUNTIME_CONTROLLER_KUNIT_TEST is not set
CONFIG_MTK_MT6797_CONSYS_G2C_PATCH_OWNER=y
# CONFIG_MTK_MT6797_CONSYS_AFE_GPS_REGISTER_SETTING is not set
