# Full p22-only MD1 boot candidate. The ordinary profiles do not select this
# fragment or apply its all-enabled overlay. The actual transaction still has
# six independent built-in command-line gates in mainline.nix.
CONFIG_MTK_MT6797_MD1_FIRMWARE_PREFLIGHT=y
CONFIG_MTK_MT6797_MD1_MPU_REMAP_PLAN=y
CONFIG_MTK_MT6797_MD1_LK_HANDOFF=y
CONFIG_MTK_MT6797_MD1_LK_HANDOFF_PROBE=y
CONFIG_MTK_MT6797_MD1_BOOT_STATUS_OBSERVE=y
CONFIG_MTK_MT6797_MD1_PRERELEASE=y
CONFIG_MTK_MT6797_MD1_COLD_OWNER=y
CONFIG_MTK_MT6797_MD1_WDT_GATE_CORE=y
CONFIG_MTK_MT6797_MD1_REMAP_ATTEST_CORE=y
CONFIG_MTK_MT6797_MD1_REMAP_OBSERVE_CORE=y
CONFIG_MTK_MT6797_MD1_REMAP_OBSERVE=y
CONFIG_MTK_MT6797_MD1_EMI_MPU_CORE=y
CONFIG_MTK_MT6797_MD1_EMI_MPU=y
CONFIG_MTK_MT6797_MD1_CLDMA_CORE=y
CONFIG_MTK_MT6797_MD1_CLDMA_PREPARE=y
# No MD1 KUnit selection belongs in a hardware p22 image.
