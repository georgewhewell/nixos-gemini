# M39: MT6351 PMIC RTC, the PMIC power key, manual s2idle and I2C chardev.
#
# The board DT already has the mediatek,mt6351-rtc node; the power-key node
# is added by the M39 kernel.  hctosys reads rtc0 at boot.  SYSTOHC stays off
# (as in the vendor aeon6797_6m_n_defconfig), so nothing writes the PMIC RTC
# unless someone runs hwclock -w; the MT6351 reload semantics are unresolved.
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
# CONFIG_RTC_SYSTOHC is not set
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_DRV_MT6397=y
# Built in so the key binds from DT without module loading.
CONFIG_KEYBOARD_MTK_PMIC=y
# System sleep.  PSCI v0.2 firmware has no SYSTEM_SUSPEND, so the only
# sleep state is s2idle ("freeze"); logind requests it when the lid has been
# closed for a while (nixos/power-policy.nix).
CONFIG_SUSPEND=y
# CONFIG_PM_AUTOSLEEP is not set
# CONFIG_PM_WAKELOCKS is not set
# Hibernation (suspend-to-disk) for suspend-then-hibernate.  Nothing
# hibernates until a swap partition is configured; Stage 1 resumes via
# /sys/power/resume only when built with a resume partition.  The image is
# LZO-compressed; there is no platform mode on arm64, so the final step is
# a plain power-off.
CONFIG_HIBERNATION=y
CONFIG_HIBERNATION_COMP_LZO=y
CONFIG_PM_STD_PARTITION=""
# M41: s2idle diagnostics.  PM_SLEEP_DEBUG (implied by PM_DEBUG with
# PM_SLEEP) adds /sys/power/pm_wakeup_irq, pm_debug_messages and pm_test
# (freezer/devices), so a first on-device run can stop short of a real
# sleep and a real sleep reports which IRQ woke it.
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# /dev/i2c-* for touch/I2C debugging with i2c-tools.  Built in: the image
# has no /lib/modules.
CONFIG_I2C_CHARDEV=y
# Persistent storage (nixos/storage.nix).  Stage 1 overlays the image's
# squashfs store with a writable layer on p32, and there are no modules in
# the initramfs, so OverlayFS is built in.  zswap compresses pages on their
# way to the p34 swap partition: on by default (zswap.enabled=1), LZ4
# (fast on the A53s), zsmalloc (the only zswap allocator in this kernel).
CONFIG_OVERLAY_FS=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_LZ4=y
CONFIG_CRYPTO_LZ4=y
