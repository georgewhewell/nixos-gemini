# Gemini right-port USB11 host.  Keep the independent left MTU3 controller in
# its already-proven gadget-only mode; USB11 uses MUSB host-only, PIO transfers,
# and the built-in r8152 driver for attached RTL815x adapters.
CONFIG_PACKET=y
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_DEFAULT_PERSIST=y
CONFIG_USB_MUSB_HDRC=y
CONFIG_USB_MUSB_HOST=y
# CONFIG_USB_MUSB_GADGET is not set
# CONFIG_USB_MUSB_DUAL_ROLE is not set
CONFIG_USB_MUSB_MEDIATEK=y
CONFIG_MUSB_PIO_ONLY=y
CONFIG_NOP_USB_XCEIV=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_MON=y
CONFIG_TYPEC=y
CONFIG_TYPEC_FUSB301=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_DYNAMIC_DEBUG=y
