CONFIG_WLAN=y
CONFIG_WIRELESS=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
# Late-load canonical owner and radio transport; retain per-boot EMI claim.
CONFIG_MTK_MT6797_CONSYS_FW_HANDOFF=y
CONFIG_MTK_MT6797_CONSYS_EMI_MPU=y
CONFIG_MTK_MT6797_CONSYS_INVENTORY=m
CONFIG_MTK_MT6797_BTIF_PIO_PLATFORM=m
CONFIG_MTK_MT6797_WIFI=m
# CONFIG_MTK_MT6797_WIFI_OPEN_AUTH_QUALIFICATION is not set
CONFIG_CFG80211=m
CONFIG_MTK_MT6797_WIFI_RADIO=y
# Keep bulk Wi-Fi traffic from monopolizing the host queue. The radio still
# needs firmware-completion accounting for BQL; validate loaded RTT on-device.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_DEFAULT=y
CONFIG_DEFAULT_FQ_CODEL=y
# CONFIG_DEFAULT_PFIFO_FAST is not set
# Bluetooth HCI endpoint on the CONSYS aggregate's full-STP channel 0.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCI_MT6797=m
