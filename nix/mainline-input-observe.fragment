# The keyboard path is the existing reviewed, polling-only AW9523 matrix
# overlay.  The touchscreen overlay does not bind a client; these built-ins
# merely make the board's input and read-only sysfs inventory observable.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_MATRIX=y
CONFIG_PINCTRL_AW9523=y
CONFIG_I2C=y
CONFIG_I2C_MT65XX=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
