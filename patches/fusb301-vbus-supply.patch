From: Gemini Mainline Maintainers <gemini-mainline@example.invalid>
Date: Sat, 29 Aug 2026 23:05:00 +0200
Subject: [PATCH] usb: typec: fusb301: control an optional VBUS supply

FUSB301 is an autonomous CC controller, but boards still need a separate
load switch to source connector VBUS.  The driver already knows whether the
attached partner is a sink.  Add an optional vbus-supply and enable it only
for that state; disable it on detach, probe failure and driver removal.

This keeps VBUS off while no sink has been detected and lets fixed-source
boards describe their load switch with the regulator framework.

Signed-off-by: Gemini Mainline Maintainers <gemini-mainline@example.invalid>
---
 .../bindings/usb/onsemi,fusb301.yaml          |  4 ++++
 drivers/usb/typec/fusb301.c                   | 45 +++++++++++++++++++++++++++
 2 files changed, 49 insertions(+)

diff --git a/Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml b/Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml
index 667d03e..7fd787e 100644
--- a/Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml
+++ b/Documentation/devicetree/bindings/usb/onsemi,fusb301.yaml
@@ -28,6 +28,10 @@ properties:
   interrupts:
     maxItems: 1
 
+  vbus-supply:
+    description:
+      Regulator supplying connector VBUS when the port is acting as a source.
+
   connector:
     type: object
     $ref: ../connector/usb-connector.yaml#
diff --git a/drivers/usb/typec/fusb301.c b/drivers/usb/typec/fusb301.c
index f399c5e..3f87b59 100644
--- a/drivers/usb/typec/fusb301.c
+++ b/drivers/usb/typec/fusb301.c
@@ -10,6 +10,7 @@
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
 #include <linux/usb/typec.h>
 
 #define FUSB301_REG_DEVICE_ID	0x01
@@ -59,8 +60,29 @@ struct fusb301 {
 	struct fwnode_handle *connector;
 	enum typec_pwr_opmode pwr_opmode;
 	unsigned int partner_type;
+	struct regulator *vbus;
+	bool vbus_on;
 };
 
+static int fusb301_set_vbus(struct fusb301 *fusb, bool on)
+{
+	int ret;
+
+	if (!fusb->vbus || fusb->vbus_on == on)
+		return 0;
+
+	if (on)
+		ret = regulator_enable(fusb->vbus);
+	else
+		ret = regulator_disable(fusb->vbus);
+	if (ret)
+		return ret;
+
+	fusb->vbus_on = on;
+	dev_info(fusb->dev, "connector VBUS %s\n", on ? "enabled" : "disabled");
+	return 0;
+}
+
 static unsigned int fusb301_mode_for_port_type(enum typec_port_type type)
 {
 	switch (type) {
@@ -155,6 +176,10 @@ static int fusb301_update_status(struct fusb301 *fusb)
 		return ret;
 
 	if (!(status & FUSB301_STATUS_ATTACH)) {
+		ret = fusb301_set_vbus(fusb, false);
+		if (ret)
+			return ret;
+
 		fusb301_unregister_partner(fusb);
 		fusb->partner_type = 0;
 		pwr_role = fusb301_default_role(fusb);
@@ -179,6 +204,13 @@ static int fusb301_update_status(struct fusb301 *fusb)
 	else
 		pwr_role = fusb301_default_role(fusb);
 
+	/* A source may apply VBUS only after CC has identified a sink. */
+	ret = fusb301_set_vbus(fusb,
+				pwr_role == TYPEC_SOURCE &&
+				(partner_type & FUSB301_TYPE_SINK));
+	if (ret)
+		return ret;
+
 	if (partner_type & FUSB301_TYPE_AUDIO_ACC)
 		desc.accessory = TYPEC_ACCESSORY_AUDIO;
 	else if (partner_type & FUSB301_TYPE_DEBUG_ACC)
@@ -284,6 +316,16 @@ static int fusb301_probe(struct i2c_client *client)
 	if (!fusb)
 		return -ENOMEM;
 
+	fusb->vbus = devm_regulator_get_optional(dev, "vbus");
+	if (IS_ERR(fusb->vbus)) {
+		ret = PTR_ERR(fusb->vbus);
+		if (ret == -ENODEV)
+			fusb->vbus = NULL;
+		else
+			return dev_err_probe(dev, ret,
+					     "failed to get VBUS supply\n");
+	}
+
 	fusb->dev = dev;
 	fusb->regmap = devm_regmap_init_i2c(client, &fusb301_regmap_config);
 	if (IS_ERR(fusb->regmap))
@@ -347,6 +387,7 @@ static int fusb301_probe(struct i2c_client *client)
 	return 0;
 
 err_unregister_port:
+	fusb301_set_vbus(fusb, false);
 	fusb301_unregister_partner(fusb);
 	typec_unregister_port(fusb->port);
 err_put_connector:
@@ -359,6 +400,7 @@ static void fusb301_remove(struct i2c_client *client)
 {
 	struct fusb301 *fusb = i2c_get_clientdata(client);
 
+	fusb301_set_vbus(fusb, false);
 	fusb301_unregister_partner(fusb);
 	typec_unregister_port(fusb->port);
 }
-- 
2.51.0
