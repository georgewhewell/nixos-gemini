From 48ec0f99486e2dfd47bfca2b09f853014df9ef8d Mon Sep 17 00:00:00 2001
From: georgewhewell <georgerw@gmail.com>
Date: Sun, 4 Oct 2026 01:11:38 +0200
Subject: [PATCH] watchdog: mediatek: pause across hibernation image I/O

The noirq freeze/thaw pair only covers snapshot creation. Thaw restarts the watchdog before swsusp_write(), while restore freezes devices only after swsusp_read(). Userspace keepalives are frozen for both I/O paths.

Use hibernation/restore PM notifications to pause the timer until POST, including aborts. Serialize start/stop requests around the freezer and retain ordinary suspend noirq handling. Exercise the real callbacks with fake MMIO in a native host test.
---
 drivers/watchdog/mtk_wdt.c                    | 108 ++++++++-
 .../selftests/watchdog/mtk-wdt-pm-host.py     | 227 ++++++++++++++++++
 2 files changed, 328 insertions(+), 7 deletions(-)
 create mode 100755 tools/testing/selftests/watchdog/mtk-wdt-pm-host.py

diff --git a/drivers/watchdog/mtk_wdt.c b/drivers/watchdog/mtk_wdt.c
index 8bca179c04a75..842f002ee63a3 100644
--- a/drivers/watchdog/mtk_wdt.c
+++ b/drivers/watchdog/mtk_wdt.c
@@ -31,6 +31,7 @@
 #include <linux/of_platform.h>
 #include <linux/platform_device.h>
 #include <linux/reset-controller.h>
+#include <linux/suspend.h>
 #include <linux/types.h>
 #include <linux/watchdog.h>
 #include <linux/interrupt.h>
@@ -80,7 +81,10 @@ static unsigned int timeout;
 struct mtk_wdt_dev {
 	struct watchdog_device wdt_dev;
 	void __iomem *wdt_base;
-	spinlock_t lock; /* protects WDT_SWSYSRST reg */
+	spinlock_t lock; /* protects reset bits and watchdog start/stop/PM state */
+	struct notifier_block pm_nb;
+	bool hibernation_paused;
+	bool hibernation_running;
 	struct reset_controller_dev rcdev;
 	bool disable_wdt_extrst;
 	bool reset_by_toprgu;
@@ -317,8 +321,6 @@ static int toprgu_register_reset_controller(struct platform_device *pdev,
 	int ret;
 	struct mtk_wdt_dev *mtk_wdt = platform_get_drvdata(pdev);
 
-	spin_lock_init(&mtk_wdt->lock);
-
 	mtk_wdt->rcdev.owner = THIS_MODULE;
 	mtk_wdt->rcdev.nr_resets = rst_num;
 	mtk_wdt->rcdev.ops = &toprgu_reset_ops;
@@ -435,7 +437,7 @@ static void mtk_wdt_init(struct watchdog_device *wdt_dev)
 			 reg, handoff_length, handoff_status, handoff_interval);
 }
 
-static int mtk_wdt_stop(struct watchdog_device *wdt_dev)
+static int __mtk_wdt_stop(struct watchdog_device *wdt_dev)
 {
 	struct mtk_wdt_dev *mtk_wdt = watchdog_get_drvdata(wdt_dev);
 	void __iomem *wdt_base = mtk_wdt->wdt_base;
@@ -449,7 +451,7 @@ static int mtk_wdt_stop(struct watchdog_device *wdt_dev)
 	return 0;
 }
 
-static int mtk_wdt_start(struct watchdog_device *wdt_dev)
+static int __mtk_wdt_start(struct watchdog_device *wdt_dev)
 {
 	u32 reg;
 	struct mtk_wdt_dev *mtk_wdt = watchdog_get_drvdata(wdt_dev);
@@ -477,6 +479,86 @@ static int mtk_wdt_start(struct watchdog_device *wdt_dev)
 	return 0;
 }
 
+static int mtk_wdt_stop(struct watchdog_device *wdt_dev)
+{
+	struct mtk_wdt_dev *mtk_wdt = watchdog_get_drvdata(wdt_dev);
+	unsigned long flags;
+	int ret;
+
+	spin_lock_irqsave(&mtk_wdt->lock, flags);
+	mtk_wdt->hibernation_running = false;
+	ret = __mtk_wdt_stop(wdt_dev);
+	spin_unlock_irqrestore(&mtk_wdt->lock, flags);
+
+	return ret;
+}
+
+static int mtk_wdt_start(struct watchdog_device *wdt_dev)
+{
+	struct mtk_wdt_dev *mtk_wdt = watchdog_get_drvdata(wdt_dev);
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&mtk_wdt->lock, flags);
+	if (mtk_wdt->hibernation_paused)
+		mtk_wdt->hibernation_running = true;
+	else
+		ret = __mtk_wdt_start(wdt_dev);
+	spin_unlock_irqrestore(&mtk_wdt->lock, flags);
+
+	return ret;
+}
+
+/*
+ * Device freeze/thaw surrounds the memory snapshot, not the image I/O. A
+ * thaw callback must not restart the watchdog before swsusp_write(), and
+ * freeze callbacks in the restore kernel run only after swsusp_read().
+ * Pause before tasks freeze and resume at POST, including abort paths.
+ *
+ * Start/stop requests can still arrive before the freezer stops userspace
+ * or after it thaws. Serialize them with this state transition and defer
+ * hardware starts while paused. Pings do not enable this watchdog.
+ */
+static int mtk_wdt_pm_notify(struct notifier_block *nb, unsigned long action,
+			     void *unused)
+{
+	struct mtk_wdt_dev *mtk_wdt = container_of(nb, struct mtk_wdt_dev, pm_nb);
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&mtk_wdt->lock, flags);
+	switch (action) {
+	case PM_HIBERNATION_PREPARE:
+	case PM_RESTORE_PREPARE:
+		if (!mtk_wdt->hibernation_paused) {
+			mtk_wdt->hibernation_running =
+				readl(mtk_wdt->wdt_base + WDT_MODE) & WDT_MODE_EN;
+			mtk_wdt->hibernation_paused = true;
+			ret = __mtk_wdt_stop(&mtk_wdt->wdt_dev);
+		}
+		break;
+	case PM_POST_HIBERNATION:
+	case PM_POST_RESTORE:
+		if (mtk_wdt->hibernation_paused) {
+			mtk_wdt->hibernation_paused = false;
+			if (mtk_wdt->hibernation_running)
+				ret = __mtk_wdt_start(&mtk_wdt->wdt_dev);
+			mtk_wdt->hibernation_running = false;
+		}
+		break;
+	}
+	spin_unlock_irqrestore(&mtk_wdt->lock, flags);
+
+	return notifier_from_errno(ret);
+}
+
+static void mtk_wdt_unregister_pm_notifier(void *data)
+{
+	struct mtk_wdt_dev *mtk_wdt = data;
+
+	unregister_pm_notifier(&mtk_wdt->pm_nb);
+}
+
 static int mtk_wdt_set_pretimeout(struct watchdog_device *wdd,
 				  unsigned int timeout)
 {
@@ -545,6 +627,7 @@ static int mtk_wdt_probe(struct platform_device *pdev)
 	if (!mtk_wdt)
 		return -ENOMEM;
 
+	spin_lock_init(&mtk_wdt->lock);
 	platform_set_drvdata(pdev, mtk_wdt);
 
 	wdt_data = of_device_get_match_data(dev);
@@ -601,6 +684,17 @@ static int mtk_wdt_probe(struct platform_device *pdev)
 	if (unlikely(err))
 		return err;
 
+	if (IS_ENABLED(CONFIG_HIBERNATION)) {
+		mtk_wdt->pm_nb.notifier_call = mtk_wdt_pm_notify;
+		err = register_pm_notifier(&mtk_wdt->pm_nb);
+		if (err)
+			return err;
+		err = devm_add_action_or_reset(dev, mtk_wdt_unregister_pm_notifier,
+					       mtk_wdt);
+		if (err)
+			return err;
+	}
+
 	dev_info(dev, "Watchdog registered (running=%d, timeout=%d sec, nowayout=%d)\n",
 		 watchdog_hw_running(&mtk_wdt->wdt_dev),
 		 mtk_wdt->wdt_dev.timeout, nowayout);
@@ -643,7 +737,7 @@ static int mtk_wdt_suspend_noirq(struct device *dev)
 {
 	struct mtk_wdt_dev *mtk_wdt = dev_get_drvdata(dev);
 
-	if (mtk_wdt_is_running(&mtk_wdt->wdt_dev))
+	if (!mtk_wdt->hibernation_paused && mtk_wdt_is_running(&mtk_wdt->wdt_dev))
 		mtk_wdt_stop(&mtk_wdt->wdt_dev);
 
 	return 0;
@@ -653,7 +747,7 @@ static int mtk_wdt_resume_noirq(struct device *dev)
 {
 	struct mtk_wdt_dev *mtk_wdt = dev_get_drvdata(dev);
 
-	if (mtk_wdt_is_running(&mtk_wdt->wdt_dev)) {
+	if (!mtk_wdt->hibernation_paused && mtk_wdt_is_running(&mtk_wdt->wdt_dev)) {
 		mtk_wdt_start(&mtk_wdt->wdt_dev);
 		mtk_wdt_ping(&mtk_wdt->wdt_dev);
 	}
diff --git a/tools/testing/selftests/watchdog/mtk-wdt-pm-host.py b/tools/testing/selftests/watchdog/mtk-wdt-pm-host.py
new file mode 100755
index 0000000000000..ca099f9735ba1
--- /dev/null
+++ b/tools/testing/selftests/watchdog/mtk-wdt-pm-host.py
@@ -0,0 +1,227 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0
+"""Run the real MediaTek watchdog PM/start/stop functions with fake MMIO.
+
+This host test checks callback ordering and state transitions, not hardware
+timing. Run from a kernel checkout with a native C compiler in CC (default cc).
+An arm64 object build is also required to check the real kernel interfaces.
+"""
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[4]
+source = (root / 'drivers/watchdog/mtk_wdt.c').read_text()
+pm = (root / 'include/linux/pm.h').read_text()
+suspend = (root / 'include/linux/suspend.h').read_text()
+
+
+def extract(pattern, text=source):
+    match = re.search(pattern, text, re.M | re.S)
+    if not match:
+        raise RuntimeError(f'Source fragment missing: {pattern}')
+    return match.group(0)
+
+
+prefix = r'''
+#include <assert.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#define __iomem
+typedef uint32_t u32;
+typedef int spinlock_t;
+struct notifier_block { int unused; };
+struct reset_controller_dev { int unused; };
+struct watchdog_device {
+    unsigned int timeout, pretimeout, status;
+    void *priv;
+};
+struct device { void *priv; };
+#define watchdog_get_drvdata(w) ((w)->priv)
+#define dev_get_drvdata(d) ((d)->priv)
+#define watchdog_active(w) ((w)->status & 1)
+#define watchdog_hw_running(w) ((w)->status & 2)
+#define container_of(p, type, field) ((type *)((char *)(p) - offsetof(type, field)))
+#define spin_lock_irqsave(lock, flags) do { assert(!*(lock)); *(lock) = 1; (flags) = 0; } while (0)
+#define spin_unlock_irqrestore(lock, flags) do { assert(*(lock)); assert(!(flags)); *(lock) = 0; } while (0)
+#define NOTIFY_OK 1
+#define notifier_from_errno(err) ((err) ? 0x8000 | (NOTIFY_OK - (err)) : NOTIFY_OK)
+static u32 readl(void *p) { return *(u32 *)p; }
+static void iowrite32(u32 value, void *p) { *(u32 *)p = value; }
+#define ioread32 readl
+#define pm_sleep_ptr(fn) (fn)
+struct dev_pm_ops {
+    int (*suspend_noirq)(struct device *);
+    int (*resume_noirq)(struct device *);
+    int (*freeze_noirq)(struct device *);
+    int (*thaw_noirq)(struct device *);
+    int (*poweroff_noirq)(struct device *);
+    int (*restore_noirq)(struct device *);
+};
+'''
+
+functions = [
+    'mtk_wdt_ping', 'mtk_wdt_set_timeout', '__mtk_wdt_stop', '__mtk_wdt_start',
+    'mtk_wdt_stop', 'mtk_wdt_start', 'mtk_wdt_pm_notify', 'mtk_wdt_is_running',
+    'mtk_wdt_suspend_noirq', 'mtk_wdt_resume_noirq',
+]
+code = prefix + '\n'.join(re.findall(r'^#define WDT_.*$', source, re.M)) + '\n'
+code += '\n'.join(re.findall(r'^#define PM_(?:POST|HIBERNATION|RESTORE|SUSPEND)_.*$', suspend, re.M)) + '\n'
+code += extract(r'struct mtk_wdt_dev \{.*?^};') + '\n'
+code += extract(r'^#define NOIRQ_SYSTEM_SLEEP_PM_OPS.*?\n\n', pm)
+for name in functions:
+    code += extract(r'^static (?:int|bool) ' + name + r'\(.*?^}\n') + '\n'
+code += extract(r'^static const struct dev_pm_ops mtk_wdt_pm_ops = \{.*?^};') + '\n'
+code += r'''
+static struct mtk_wdt_dev w;
+static struct device d = { .priv = &w };
+static u32 regs[64];
+
+static bool running(void) { return regs[WDT_MODE / 4] & WDT_MODE_EN; }
+static void setup(unsigned int status, bool enabled)
+{
+    memset(&w, 0, sizeof(w));
+    memset(regs, 0, sizeof(regs));
+    w.wdt_base = regs;
+    w.wdt_dev.priv = &w;
+    w.wdt_dev.timeout = 31;
+    w.wdt_dev.status = status | 4; /* preserve a nowayout-like policy bit */
+    regs[WDT_MODE / 4] = enabled ? WDT_MODE_EN : 0;
+}
+static void notify(unsigned long action)
+{
+    assert(mtk_wdt_pm_notify(&w.pm_nb, action, NULL) == NOTIFY_OK);
+    assert(!w.lock);
+}
+static void image_io(void)
+{
+    /* Even core-worker or userspace pings must not enable the paused WDT. */
+    assert(w.hibernation_paused);
+    for (int i = 0; i < 100; i++) {
+        assert(!running());
+        assert(!mtk_wdt_ping(&w.wdt_dev));
+    }
+    assert(!running());
+}
+static void test_suspend(unsigned int status, bool enabled)
+{
+    setup(status, enabled);
+    notify(PM_SUSPEND_PREPARE);
+    assert(running() == enabled);
+    assert(!mtk_wdt_pm_ops.suspend_noirq(&d));
+    assert(!running());
+    assert(!mtk_wdt_pm_ops.resume_noirq(&d));
+    notify(PM_POST_SUSPEND);
+    assert(running() == enabled);
+    assert(w.wdt_dev.status == (status | 4));
+}
+static void test_hibernation(unsigned int status, bool enabled)
+{
+    setup(status, enabled);
+    notify(PM_HIBERNATION_PREPARE);
+    image_io();
+    assert(!mtk_wdt_pm_ops.freeze_noirq(&d));
+    assert(!mtk_wdt_pm_ops.thaw_noirq(&d));
+    image_io(); /* swsusp_write() follows thaw */
+    notify(PM_POST_HIBERNATION);
+    assert(!w.hibernation_paused);
+    assert(running() == enabled);
+    assert(w.wdt_dev.status == (status | 4));
+}
+static void test_restore_failure(unsigned int status, bool enabled)
+{
+    setup(status, enabled);
+    notify(PM_RESTORE_PREPARE);
+    image_io(); /* swsusp_read() precedes device freeze */
+    assert(!mtk_wdt_pm_ops.freeze_noirq(&d));
+    assert(!mtk_wdt_pm_ops.thaw_noirq(&d));
+    image_io();
+    notify(PM_POST_RESTORE);
+    assert(running() == enabled);
+}
+static void test_abort_before_device_freeze(void)
+{
+    setup(1, true);
+    notify(PM_HIBERNATION_PREPARE);
+    notify(PM_POST_HIBERNATION);
+    assert(running());
+    notify(PM_RESTORE_PREPARE);
+    notify(PM_POST_RESTORE);
+    assert(running());
+}
+static void test_start_stop_while_paused(void)
+{
+    setup(0, false);
+    notify(PM_HIBERNATION_PREPARE);
+    assert(!mtk_wdt_start(&w.wdt_dev));
+    image_io();
+    notify(PM_POST_HIBERNATION);
+    assert(running()); /* userspace opened it after PREPARE */
+
+    setup(1, true);
+    notify(PM_HIBERNATION_PREPARE);
+    assert(!mtk_wdt_stop(&w.wdt_dev));
+    image_io();
+    notify(PM_POST_HIBERNATION);
+    assert(!running()); /* userspace explicitly stopped it */
+}
+static void test_restored_snapshot(void)
+{
+    struct mtk_wdt_dev saved;
+    setup(1, true);
+    notify(PM_HIBERNATION_PREPARE);
+    assert(!mtk_wdt_pm_ops.freeze_noirq(&d));
+    saved = w;
+    assert(!mtk_wdt_pm_ops.thaw_noirq(&d));
+    image_io();
+    setup(1, true); /* boot kernel */
+    notify(PM_RESTORE_PREPARE);
+    image_io();
+    w = saved; /* restore kernel memory including notifier state */
+    assert(!mtk_wdt_pm_ops.restore_noirq(&d));
+    image_io();
+    notify(PM_POST_HIBERNATION); /* restored kernel completes hibernate() */
+    assert(running());
+}
+static void test_duplicate_notifications(void)
+{
+    setup(1, true);
+    notify(PM_HIBERNATION_PREPARE);
+    notify(PM_HIBERNATION_PREPARE);
+    image_io();
+    notify(PM_POST_HIBERNATION);
+    assert(running());
+    assert(!mtk_wdt_stop(&w.wdt_dev));
+    notify(PM_POST_HIBERNATION);
+    assert(!running());
+}
+int main(void)
+{
+    for (unsigned int status = 0; status < 4; status++) {
+        test_suspend(status, status != 0);
+        test_hibernation(status, status != 0);
+        test_restore_failure(status, status != 0);
+    }
+    test_abort_before_device_freeze();
+    test_start_stop_while_paused();
+    test_restored_snapshot();
+    test_duplicate_notifications();
+    puts("mtk-wdt-pm-host: PASS (16 PM sequences, real driver functions)");
+    return 0;
+}
+'''
+
+with tempfile.TemporaryDirectory(prefix='mtk-wdt-pm-') as tmp:
+    c = Path(tmp) / 'test.c'
+    binary = Path(tmp) / 'test'
+    c.write_text(code)
+    subprocess.run(shlex.split(os.environ.get('HOSTCC', 'cc')) +
+                   ['-std=gnu11', '-O2', '-Wall', '-Wextra', '-Werror',
+                    '-Wno-unused-parameter', str(c), '-o', str(binary)], check=True)
+    subprocess.run([str(binary)], check=True)
-- 
2.55.0

