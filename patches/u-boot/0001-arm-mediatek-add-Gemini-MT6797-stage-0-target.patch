diff --git a/arch/arm/dts/Makefile b/arch/arm/dts/Makefile
index a02dad22..21550035 100644
--- a/arch/arm/dts/Makefile
+++ b/arch/arm/dts/Makefile
@@ -1072,6 +1072,7 @@ mt8371-genio-520-evk-ufs-dtbs := mt8371-genio-520-evk.dtb mt8371-genio-common-uf
 mt8391-genio-720-evk-ufs-dtbs := mt8391-genio-720-evk.dtb mt8371-genio-common-ufs.dtbo
 
 dtb-$(CONFIG_ARCH_MEDIATEK) += \
+	mt6797-gemini-pda.dtb \
 	mt7622-rfb.dtb \
 	mt7623a-unielec-u7623-02-emmc.dtb \
 	mt7622-bananapi-bpi-r64.dtb \
diff --git a/arch/arm/dts/mt6797-gemini-pda.dts b/arch/arm/dts/mt6797-gemini-pda.dts
new file mode 100644
index 00000000..48707a26
--- /dev/null
+++ b/arch/arm/dts/mt6797-gemini-pda.dts
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-2.0 OR MIT
+
+/dts-v1/;
+
+/ {
+	model = "Planet Computers Gemini PDA";
+	compatible = "planet,gemini-pda", "mediatek,mt6797";
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &serial_null;
+	};
+
+	chosen {
+		stdout-path = &serial_null;
+	};
+
+	serial_null: serial {
+		compatible = "nulldev-serial";
+	};
+
+	memory@40001000 {
+		device_type = "memory";
+		reg = <0 0x40001000 0 0x03ffe000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		stage0-trace@43fff000 {
+			reg = <0 0x43fff000 0 0x1000>;
+			no-map;
+		};
+	};
+};
diff --git a/arch/arm/mach-mediatek/Kconfig b/arch/arm/mach-mediatek/Kconfig
index 5e6c50ca..04e322d6 100644
--- a/arch/arm/mach-mediatek/Kconfig
+++ b/arch/arm/mach-mediatek/Kconfig
@@ -4,6 +4,7 @@ config SYS_SOC
 	default "mediatek"
 
 config SYS_VENDOR
+	default "planet" if TARGET_MT6797
 	default "mediatek"
 
 choice
@@ -75,6 +76,15 @@ config TARGET_MT7988
 	  including UART, SPI, SPI flash, USB3.0, MMC, NAND, SNFI, PWM, PCIe,
 	  10 Gigabit Ethernet , I2C, and PCIe.
 
+config TARGET_MT6797
+	bool "MediaTek MT6797 SoC"
+	select ARM64
+	help
+	  The MediaTek MT6797 is an ARM64 SoC with two Cortex-A72 cores and
+	  two four-core Cortex-A53 clusters. This target supports a U-Boot
+	  proper payload chainloaded by the vendor LK boot loader after DRAM
+	  and platform firmware initialization.
+
 config TARGET_MT8183
 	bool "MediaTek MT8183 SoC"
 	select ARM64
@@ -161,6 +171,7 @@ config MTK_MEM_MAP_DDR_SIZE
 	default 0x200000000 if TARGET_MT7987 || TARGET_MT7988 || TARGET_MT8188 || TARGET_MT8195
 	default 0xc0000000 if TARGET_MT8365
 	default 0x80000000 if TARGET_MT7981 || TARGET_MT7986 || TARGET_MT8183
+	default 0x04000000 if TARGET_MT6797
 	default 0x40000000 if TARGET_MT7622 || TARGET_MT8512
 	default 0x20000000
 	help
@@ -177,6 +188,7 @@ endif
 
 config SYS_BOARD
 	string "Board name"
+	default "gemini" if TARGET_MT6797
 	default "mt7622" if TARGET_MT7622
 	default "mt7623" if TARGET_MT7623
 	default "mt7629" if TARGET_MT7629
@@ -195,6 +207,7 @@ config SYS_BOARD
 	  be used.
 
 config SYS_CONFIG_NAME
+	default "mt6797" if TARGET_MT6797
 	default "mt7623" if TARGET_MT7623
 	default "mt7629" if TARGET_MT7629
 	default "mt7981" if TARGET_MT7981
