diff --git a/arch/arm/mach-mediatek/mt6797/init.c b/arch/arm/mach-mediatek/mt6797/init.c
new file mode 100644
index 00000000..3f903ce7
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6797/init.c
@@ -0,0 +1,32 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <fdtdec.h>
+#include <init.h>
+#include <stdio.h>
+#include <linux/kernel.h>
+#include <asm/global_data.h>
+#include <asm/system.h>
+
+DECLARE_GLOBAL_DATA_PTR;
+
+int dram_init(void)
+{
+	return fdtdec_setup_mem_size_base();
+}
+
+phys_addr_t board_get_usable_ram_top(phys_size_t total_size)
+{
+	/* Stay below LK's tags and the vendor persistent trace reservations. */
+	return min(gd->ram_top, (phys_addr_t)0x43fff000);
+}
+
+void reset_cpu(void)
+{
+	psci_system_reset();
+}
+
+int print_cpuinfo(void)
+{
+	printf("CPU:   MediaTek MT6797 (LK handoff)\n");
+	return 0;
+}
diff --git a/arch/arm/mach-mediatek/mt6797/lowlevel_init.S b/arch/arm/mach-mediatek/mt6797/lowlevel_init.S
new file mode 100644
index 00000000..02bd0ee6
--- /dev/null
+++ b/arch/arm/mach-mediatek/mt6797/lowlevel_init.S
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+
+#include <linux/linkage.h>
+
+#define GEMINI_TRACE_BASE	0x43fff000
+#define GEMINI_TRACE_MAGIC	0x31303042554d4547
+#define MT6797_WDT_BASE		0x10007000
+#define MT6797_WDT_MODE		0x00
+#define MT6797_WDT_MODE_KEY	0x22000000
+#define MT6797_WDT_MODE_CLEAR	0x4a
+#define MT6797_WDT_MODE_SET	0x15
+#define MT6797_WDT_RESTART_KEY	0x1971
+
+/*
+ * LK enters the payload with the boot tags in x0 and an active watchdog.
+ * Record the handoff before U-Boot changes exception state, caches or DRAM.
+ */
+.global save_boot_params
+save_boot_params:
+	mov	x8, #0xf000
+	movk	x8, #0x43ff, lsl #16
+	str	xzr, [x8, #0x00]
+	mov	x9, #1
+	str	x9, [x8, #0x08]
+	mov	x9, #0xa8
+	str	x9, [x8, #0x10]
+	mov	x9, #1
+	str	x9, [x8, #0x18]
+	adr	x9, _start
+	str	x9, [x8, #0x20]
+	stp	x0, x1, [x8, #0x28]
+	stp	x2, x3, [x8, #0x38]
+	mrs	x11, CurrentEL
+	str	x11, [x8, #0x48]
+	mrs	x9, mpidr_el1
+	str	x9, [x8, #0x50]
+	mrs	x9, cntfrq_el0
+	str	x9, [x8, #0x58]
+	mrs	x9, cntvct_el0
+	str	x9, [x8, #0x60]
+
+	cmp	x11, #0xc
+	b.eq	1f
+	cmp	x11, #0x8
+	b.eq	2f
+	mrs	x9, sctlr_el1
+	b	3f
+1:	mrs	x9, sctlr_el3
+	b	3f
+2:	mrs	x9, sctlr_el2
+3:	str	x9, [x8, #0x68]
+
+	mov	x10, #0x7000
+	movk	x10, #0x1000, lsl #16
+	ldr	w9, [x10, #0x00]
+	str	x9, [x8, #0x70]
+	ldr	w9, [x10, #0x04]
+	str	x9, [x8, #0x78]
+	ldr	w9, [x10, #0x0c]
+	str	x9, [x8, #0x80]
+	ldr	w9, [x10, #0x10]
+	str	x9, [x8, #0x88]
+	stp	xzr, xzr, [x8, #0x90]
+
+	/* Make expiry reset directly even if LK entered in IRQ/dual mode. */
+	ldr	w9, [x10, #MT6797_WDT_MODE]
+	mov	w12, #MT6797_WDT_MODE_CLEAR
+	bic	w9, w9, w12
+	mov	w12, #MT6797_WDT_MODE_SET
+	orr	w9, w9, w12
+	mov	w11, #0x2200
+	lsl	w11, w11, #16
+	orr	w9, w9, w11
+	str	w9, [x10, #MT6797_WDT_MODE]
+	dsb	sy
+
+	mov	x9, #MT6797_WDT_RESTART_KEY
+	str	w9, [x10, #0x08]
+	dsb	sy
+	mov	x9, #0x4547
+	movk	x9, #0x554d, lsl #16
+	movk	x9, #0x3042, lsl #32
+	movk	x9, #0x3130, lsl #48
+	mvn	x11, x9
+	str	x11, [x8, #0xa0]
+	dsb	st
+	str	x9, [x8, #0x00]
+	dsb	sy
+	b	save_boot_params_ret
