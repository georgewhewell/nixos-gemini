diff --git a/board/planet/gemini/gemini.c b/board/planet/gemini/gemini.c
new file mode 100644
index 00000000..4da4d4cc
--- /dev/null
+++ b/board/planet/gemini/gemini.c
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: GPL-2.0
+
+#include <stddef.h>
+#include <asm/cache.h>
+#include <asm/global_data.h>
+#include <asm/io.h>
+#include <asm/system.h>
+
+#define GEMINI_TRACE_BASE		0x43fff000
+#define GEMINI_TRACE_MAGIC		0x31303042554d4547ULL
+#define MT6797_WDT_BASE			0x10007000
+#define MT6797_WDT_RESTART		0x08
+#define MT6797_WDT_RESTART_KEY		0x1971
+
+struct gemini_stage0_trace {
+	u64 magic;
+	u64 version;
+	u64 length;
+	u64 stage;
+	u64 runtime_entry;
+	u64 args[4];
+	u64 current_el;
+	u64 mpidr;
+	u64 counter_frequency;
+	u64 entry_counter;
+	u64 sctlr;
+	u64 wdt_mode;
+	u64 wdt_length;
+	u64 wdt_status;
+	u64 wdt_interval;
+	u64 relocated_address;
+	u64 ram_top;
+	u64 magic_complement;
+};
+
+static_assert(offsetof(struct gemini_stage0_trace, stage) == 0x18);
+static_assert(offsetof(struct gemini_stage0_trace, args) == 0x28);
+static_assert(offsetof(struct gemini_stage0_trace, wdt_mode) == 0x70);
+static_assert(offsetof(struct gemini_stage0_trace, relocated_address) == 0x90);
+static_assert(offsetof(struct gemini_stage0_trace, magic_complement) == 0xa0);
+static_assert(sizeof(struct gemini_stage0_trace) == 0xa8);
+
+DECLARE_GLOBAL_DATA_PTR;
+
+static volatile struct gemini_stage0_trace *const trace =
+	(volatile struct gemini_stage0_trace *)GEMINI_TRACE_BASE;
+
+static void gemini_trace_flush(void)
+{
+	flush_dcache_range(GEMINI_TRACE_BASE, GEMINI_TRACE_BASE + 0x1000);
+	dsb();
+}
+
+static void gemini_stage(unsigned int stage, bool relocated)
+{
+	writel(MT6797_WDT_RESTART_KEY,
+	       (void __iomem *)(MT6797_WDT_BASE + MT6797_WDT_RESTART));
+
+	/* Make every post-relocation update commit-last, just like stage 1. */
+	trace->magic = 0;
+	gemini_trace_flush();
+	if (relocated) {
+		trace->relocated_address = gd->relocaddr;
+		trace->ram_top = gd->ram_top;
+	}
+	trace->stage = stage;
+	trace->magic_complement = ~GEMINI_TRACE_MAGIC;
+	gemini_trace_flush();
+	trace->magic = GEMINI_TRACE_MAGIC;
+	gemini_trace_flush();
+}
+
+int board_early_init_f(void)
+{
+	gemini_stage(2, false);
+	return 0;
+}
+
+int board_init(void)
+{
+	gemini_stage(3, false);
+	return 0;
+}
+
+int board_late_init(void)
+{
+	gemini_stage(4, true);
+
+	/* Do not pet or stop LK's watchdog: recovery is the stage-0 exit path. */
+	asm volatile("msr daifset, #0xf\n\tisb" ::: "memory");
+	for (;;)
+		wfi();
+}
